# Copier ce fichier en .env puis adapter les valeurs
NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgres://beautedor:beautedor@localhost:5432/beautedor
# Mettre true pour les bases managées (Render, Neon, Supabase…)
DATABASE_SSL=false

# Secret JWT : 32 caractères minimum en production
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire-de-48-octets

# Origine du frontend en développement (Vite)
CLIENT_ORIGIN=http://localhost:5173

# Compte administrateur créé par `npm run db:seed` (changez le mot de passe !)
ADMIN_EMAIL=admin@beautedor.sn
ADMIN_PASSWORD=Admin@2026

# Production derrière HTTPS : laisser vide. Pour tester la prod en HTTP local : COOKIE_SECURE=false
# COOKIE_SECURE=false
